# ============================================================
# 知识库管理平台 — 环境变量模板
# 复制为 .env 后填入实际值
# ============================================================

# ---- 必填：API 密钥 ----
EMBEDDING_API_KEY=
LLM_API_KEY=
RERANK_API_KEY=

# ---- 可选：Embedding 服务 ----
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_LOCAL=false
EMBEDDING_MODEL_DIR=/app/models
HF_ENDPOINT=https://hf-mirror.com

# ---- 可选：LLM 服务 ----
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ---- 可选：Rerank 服务 ----
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 可选：运行环境 (development | production) ----
APP_ENV=development

# ---- 可选：产品模式 (education | personal) ----
APP_MODE=education

# ---- 可选：JWT ----
# 生产环境必须修改，且长度 >= 32 字节
JWT_SECRET_KEY=change-me-in-production

# ---- 可选：首次部署管理员 ----
# 仅在数据库中尚无 admin 时生效；留空不会创建默认账号。
INITIAL_ADMIN_PASSWORD=

# ---- 可选：FAQ 挖掘参数 ----
FAQ_MINING_DAYS=30
FAQ_MINING_THRESHOLD=3

# ---- 可选：外部 OCR 服务 ----
USE_UNLIMITED_OCR=false
UNLIMITED_OCR_URL=
